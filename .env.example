# Скопируйте файл в .env и заполните значения

# Домен, на который указывает A-запись (Caddy выпустит HTTPS-сертификат)
IMPULSE_DOMAIN=chat.example.ru

# Интерфейс сервера. 127.0.0.1 — только локально (безопасный default).
# Для доступа с телефона/другого компьютера в LAN задайте 0.0.0.0.
# В docker-compose HOST=0.0.0.0 уже задан для связи с Caddy.
HOST=127.0.0.1

# Список разрешённых браузерных origin через запятую. Same-origin,
# Electron и Android WebView разрешены автоматически. Пример:
# CORS_ORIGINS=https://chat.example.ru,https://admin.example.ru
# Не используйте *.
CORS_ORIGINS=

# Максимальный размер одного файла и суммарное хранилище файлов пользователя
# (в байтах). По умолчанию 1 ГБ на файл и 5 ГБ на пользователя.
MAX_FILE_SIZE=1073741824
MAX_USER_STORAGE=5368709120

# Секрет для подписи JWT (не короче 32 символов, сгенерируйте случайный)
JWT_SECRET=

# Ключ шифрования ключей чатов (base64, 32 байта). Если пусто — при первом
# запуске создаётся data/.master-key. Его нужно хранить вместе с data/.
MASTER_KEY=

# Демо-режим SMS: возвращать код в ответе API, писать его в sms.log и
# показывать в клиенте. Небезопасно для публичного сервера: любой, кто
# видит код, может войти под этим номером. В production включайте только
# для доверенного демо-сервера. Без SMS_DEV_MODE production вернёт 503 и
# не запишет код в лог: реальный SMS-провайдер в проекте пока не подключён.
# SMS_DEV_MODE=1

# --- P2P / сборка клиента ---
# Адрес сигналинга для APK и публичной Windows-сборки. Можно не задавать:
# Android по умолчанию использует https://moy-server-2026.loca.lt.
# Указывайте только origin без /api и завершающего слэша.
# VITE_SERVER_URL=https://moy-server-2026.loca.lt

# Необязательный TURN для строгого симметричного CGNAT. WebRTC сначала
# использует бесплатные STUN, затем TURN (если задан), затем WebSocket-relay
# текущего сервера. Переменные VITE_* читаются при сборке клиента; задавайте
# их в оболочке или в desktop/.env (electron-vite запускается из desktop/).
# VITE_TURN_URLS=turn:turn.example.net:3478?transport=udp,turn:turn.example.net:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# localtunnel: порт и поддомен используют все .cmd/.ps1 скрипты.
# IMPULSE_PORT=3000
# IMPULSE_SUBDOMAIN=moy-server-2026
